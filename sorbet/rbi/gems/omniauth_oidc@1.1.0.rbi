# Thread-safe cache with a per-entry TTL.
#
# Reads take a short global lock only. Fetches run under a per-key lock, so a
# slow or hanging upstream for one key never blocks cache hits for other keys,
# and concurrent misses for the same key trigger a single fetch.
#
# pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:9
class OmniauthOidc::TtlCache
  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:14
  def initialize(ttl:, name: T.unsafe(nil)); end

  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:54
  def clear!; end

  # Returns the cached value for key, calling the block to fetch it on a miss.
  #
  # ttl:           seconds an entry stays valid (defaults to the cache TTL)
  # force_refresh: fetch even if the entry is still valid
  # min_age:       with force_refresh, reuse an entry fetched less than this many
  #                seconds ago. Rate limits refreshes that callers can trigger.
  #
  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:28
  def fetch(key, force_refresh: T.unsafe(nil), ttl: T.unsafe(nil), min_age: T.unsafe(nil), &block); end

  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:49
  def invalidate(key); end

  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:12
  def ttl; end

  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:59
  def ttl=(value); end

  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:45
  def valid?(key); end

  private

  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:69
  def hit(key, entry); end

  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:78
  def lock_for(key); end

  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:65
  def read(key); end

  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:74
  def younger_than?(entry, seconds); end
end

# pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:10
class OmniauthOidc::TtlCache::Entry < ::Struct
  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:10
  def fetched_at; end

  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:10
  def fetched_at=(_); end

  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:10
  def value; end

  # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:10
  def value=(_); end

  class << self
    # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:10
    def [](*_arg0); end

    # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:10
    def inspect; end

    # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:10
    def keyword_init?; end

    # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:10
    def members; end

    # pkg:gem/omniauth_oidc#lib/omniauth/oidc/ttl_cache.rb:10
    def new(*_arg0); end
  end
end

