{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^images\\.yaml$/"],
      "matchStrings": [
        "# release-mirror: (?<depName>[a-z0-9_-]+) versioning=(?<versioning>[^\\s]+)\\s+image: [^\\s@]+:(?<currentValue>[a-zA-Z0-9_][a-zA-Z0-9_.-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "custom.release-mirror"
    }
  ],
  "customDatasources": {
    "release-mirror": {
      "defaultRegistryUrlTemplate": "https://catalogue.example.test/api/v1/services/{{packageName}}/renovate",
      "format": "json"
    }
  },
  "packageRules": [
    {
      "matchDatasources": ["custom.release-mirror"],
      "pinDigests": true,
      "digest": {"enabled": true}
    }
  ]
}
